    "whisper_model": "models/ggml-base.en.bin",
    "piper_model": "models/piper/en_US-lessac-medium.onnx",
    "kws_model_dir": "models/kws",
    "vad_silence_ms": 900,
    "vad_threshold": 0.012,
    "vad_start_timeout_s": 6,
    "max_record_seconds": 15,
    "wake_threshold": 0.25,
    "whisper_threads": 6,
    "tts_enabled": true,
    "stream_tts": true
  },
  "idle": {
    "enabled": true,
    "timeout_s": 45,
    "lazy_model": true,
    "unload_model_after_s": 900,
    "priority": true,
    "trim_memory": true,
    "kws_threads": 1,
    "energy_gate": true,
    "energy_threshold": 0.006,
    "pre_roll_blocks": 3
  },
  "utcp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8191,
    "token": "",
