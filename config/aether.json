{
  "version": 1,
  "model": {
    "primary": "models/qwen2.5-3b-instruct-q4_k_m.gguf",
    "fallback": "models/qwen2.5-1.5b-instruct-q4_k_m.gguf",
    "auto_fallback": true
  },
  "llama": {
    "server": "runtime/llama/llama-server.exe",
    "host": "127.0.0.1",
    "port": 8181,
    "gpu_layers": 99,
    "context": 8192,
    "adaptive_context": true,
    "threads": 6,
    "batch": 512,
    "ubatch": 256,
    "flash_attn": true,
    "kv_cache_type": "q8_0",
    "start_timeout": 150,
    "extra_args": ["--jinja", "--no-warmup"]
  },
  "generation": {
    "temperature": 0.2,
    "top_p": 0.9,
    "max_tokens": 2048,
    "coding_max_tokens": 3072,
    "coding_temperature": 0.1,
    "repeat_penalty": 1.08,
    "max_continuations": 1,
    "research_max_tokens": 3000,
    "research_temperature": 0.3
  },
  "memory": {
    "db": "data/aether.db",
    "retrieval_chunks": 8,
    "max_context_chars": 9000,
    "max_message_chars": 6000,
    "history_turns": 10
  },
  "index": {
    "folders": [],
